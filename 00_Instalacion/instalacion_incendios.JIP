{\rtf1\ansi \deff0\deflang1024{\fonttbl{\f0\fswiss Arial;}{\f1\froman Symbol;}{\f2\fswiss Arial;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;

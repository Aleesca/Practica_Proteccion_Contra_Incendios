\paperw12240\paperh15840\margl850\margr850\margt700\margb700\gutter0 \ftnbj\hyphhotz425 \sectd \linex0\headery709\footery709\colsx709 \pard\plain \qc \f2\fs24\lang1034 {\plain \f2\fs28\b\lang1034 ANEXO DE CALCULOS}{\plain \b\f2\lang1034
\par }\pard \qc 
\par
\par \pard {\b F}{\b \'f3}{\b rmulas Generales}{\b
\par }{\ul
\par }\fs18 Emplearemos las siguientes:
\par \pard
\par \pard \li567 H = Z + (P/{\f1 g} ) ;  {\f1 g} = {\f1 r} x g ;  H{\fs12 \dn6 1} = H{\fs12 \dn6 2} + h{\fs12 \dn6 f}  
\par \par \pard Siendo: 
\par \pard \li567 H = Altura piezom\'e9trica, energ\'eda por unidad de peso (mca).
\par z = Cota (m).
\par P/{\f1 g} = Altura de presi\'f3n (mca).
\par {\f1 g} = Peso espec\'edfico fluido.
\par {\f1 r} = Densidad fluido (kg/m\'b3).
\par g = Aceleraci\'f3n gravedad. 9,81 m/s\'b2.
\par h{\fs12 \dn6 f} = P\'e9rdidas de altura piezom\'e9trica, energ\'eda por unidad de peso (mca).
\par \par \pard a) {\ul Tuber\'edas y v\'e1lvulas}.
\par \par \pard \li567 H{\fs12 \dn6 i} - H{\fs12 \dn6 j} = h{\fs12 \dn6 ij} = r{\fs12 \dn6 ij} x Q{\fs12 \dn6 ij}{\fs12 \up6 n} + m{\fs12 \dn6 ij} x Q{\fs12 \dn6 ij}\'b2 
\par 
\par Darcy - Weisbach :
\par r{\fs12 \dn6 ij} = 10{\fs12 \up6 9} x 8 x f x L x {\f1 r} / ({\f1 p}\'b2 x g x D{\fs12 \up6 5} x 1000) ; n = 2 
\par m{\fs12 \dn6 ij} = 10{\fs12 \up6 6} x 8 x k x {\f1 r} / ({\f1 p}\'b2 x g x D{\fs12 \up6 4} x 1000) 
\par Re = 4 x Q / ({\f1 p} x D x {\f1 n}) 
 \par Re {\f1 \'a3} 2000: Laminar, f\'f3rmula de Hagen-Poiseuille:  f = 64 / Re 
\par Re {\f1 \'b3} 4000: Turbulento:  f = 0.25 / [lg{\fs12 \dn6 10}({\f1 e} / (3.7 x D) + 5.74 / Re{\fs12 \up6 0.9} )]\'b2 
\par 2000 {\f1 \'3c} Re {\f1 \'3c} 4000: Se emplea una interpolaci\'f3n c\'fabica 
\par 
\par Hazen - Williams :
\par r{\fs12 \dn6 ij} = 12,171 x 10{\fs12 \up6 9} x L / (C{\fs12 \up6 1,852} x D{\fs12 \up6 4,871} ) ; n = 1,852 
\par m{\fs12 \dn6 ij} = 10{\fs12 \up6 6} x 8 x k / ({\f1 p}\'b2 x g x D{\fs12 \up6 4} ) 
\par \par \pard b) {\ul Bombas-Grupos de presi\'f3n}.
\par \par \pard \li567 h{\fs12 \dn6 ij} = -{\f1 w}\'b2 x (h{\fs12 \dn6 0} - rb x (Q/{\f1 w}){\fs12 \up6 nb}) 
\par \par \pard Siendo: 
\par \pard \li567 f = Factor de fricci\'f3n en tuber\'edas (adimensional).
\par L = Longitud equivalente de tuber\'eda (m).
\par D = Di\'e1metro de tuber\'eda o v\'e1lvula (mm).
\par Q = Caudal (l/s).
\par {\f1 e} = Rugosidad absoluta tuber\'eda (mm).
\par Re = N\'famero de Reynolds (adimensional).
\par {\f1 n} = Viscosidad cinem\'e1tica del fluido (m\'b2/s).
\par k = Coeficiente de p\'e9rdidas en v\'e1lvula (adimensional).
\par {\f1 w} = Coeficiente de velocidad en bombas (adimensional).
\par h{\fs12 \dn6 0} = Altura bomba a caudal cero (mca). 
\par rb = Coeficiente en bombas.
\par nb = Exponente caudal en bombas.
\par \pard
\par \pard
\par \pard c) {\ul BIES}.
\par \par \pard \li567 Q(l/min) = K{\fs12 \dn6 BIE} x \plain\f1\fs18 \'d6\plain\f0\fs18 Pma(bar) 
\par \pard \li567 Q(l/min) = K{\fs12 \dn6 boq} x \plain\f1\fs18 \'d6\plain\f0\fs18 Pboq(bar) 
\par K{\fs12 \dn6 BIE} = Coeficiente de caudal BIE. 
 \par K{\fs12 \dn6 boq} = Coeficiente de caudal boquilla. 
 \par \pard
\par \pard d) {\ul Rociador Autom\'e1tico}.
\par \par \pard \li567 Q(l/min) = k x \plain\f1\fs18 \'d6\plain\f0\fs18 P(bar) 
\par k = Coeficiente rociador. 
 \par \pard
\par
\par {\fs26\b Red IPCI 1}
\par 
\par {\fs24\b Datos Generales Instalación }
\par 
\par C\'e1lculo por: Hazen - Williams 
\par P\'e9rdidas secundarias: 20 % 
\par Velocidad m\'e1xima: 10 m/s 
\par Presi\'f3n din\'e1mica m\'ednima: 
\par \tab BIE; Pm\'ednima-boquilla(bar): 2 ;Pm\'e1xima-boquilla(bar): 5 
\par \tab HIDRANTE EXTERIOR; Pm\'ednima(bar): 5 
\par \tab ROCIADOR AUTOMATICO; Pm\'ednima(bar): 
\par \tab \tab LIGERO: 0,7 
; ORDINARIO: 0,57 
; EXTRAORDINARIO: 0,5 
\par \pard
\par \pard 
